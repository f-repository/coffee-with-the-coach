{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": { "@supabase/supabase-js": ["../node_modules/@supabase/supabase-js"] }
  },
  "include": ["functions/**/*.ts", "tests/deno-shim.d.ts"]
}
